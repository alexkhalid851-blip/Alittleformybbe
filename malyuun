
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little Place for You ♡</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
:root {
    --cream: #fff9f5;
    --pink: #f5dce0;
    --rose: #bc777f;
    --dark: #513b40;
    --muted: #957b7e;
    --gold: #c5a47a;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--cream);
    color: var(--dark);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
}

/* BACKGROUND DECORATION */

.background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
}

.glow {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: .3;
}

.glow.one {
    background: #f3cbd4;
    top: -150px;
    left: -150px;
}

.glow.two {
    background: #ead9c5;
    bottom: -150px;
    right: -150px;
}

/* NAVIGATION */

nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
}

.logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    font-style: italic;
    color: var(--rose);
}

.nav-note {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
}

/* HERO */

.hero {
    position: relative;
    z-index: 1;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 50px 20px 80px;
}

.eyebrow {
    text-transform: uppercase;
    letter-spacing: 5px;
    font-size: 10px;
    color: var(--rose);
    margin-bottom: 25px;
    animation: fadeUp 1s ease both;
}

.hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: clamp(55px, 10vw, 105px);
    line-height: .95;
    max-width: 900px;
    animation: fadeUp 1.2s ease both;
}

.hero h1 em {
    color: var(--rose);
    font-weight: 400;
}

.hero-text {
    max-width: 450px;
    line-height: 2;
    color: var(--muted);
    font-size: 14px;
    margin-top: 30px;
    animation: fadeUp 1.4s ease both;
}

.hero-btn {
    margin-top: 38px;
    border: 1px solid #d7a6ac;
    background: transparent;
    color: var(--dark);
    padding: 15px 35px;
    border-radius: 50px;
    font-family: inherit;
    letter-spacing: 1px;
    font-size: 11px;
    cursor: pointer;
    transition: .4s;
    animation: fadeUp 1.6s ease both;
}

.hero-btn:hover {
    background: var(--rose);
    color: white;
    transform: translateY(-4px);
}

/* FLOATING HEARTS */

.heart {
    position: fixed;
    bottom: -30px;
    color: #d99da8;
    pointer-events: none;
    z-index: 5;
    animation: floatHeart 8s linear forwards;
}

@keyframes floatHeart {
    0% { transform: translateY(0) rotate(0deg); opacity: 0; }
    15% { opacity: .7; }
    100% { transform: translateY(-110vh) rotate(40deg); opacity: 0; }
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(25px); }
    to { opacity: 1; transform: translateY(0); }
}

/* DIVIDER */

.divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 20px auto 70px;
    color: var(--rose);
    font-size: 17px;
}

.divider::before,
.divider::after {
    content: "";
    height: 1px;
    width: 55px;
    background: #e7c9ca;
}

/* LETTER */

.section {
    position: relative;
    z-index: 1;
    padding: 80px 20px;
}

.letter {
    max-width: 720px;
    margin: auto;
    background: rgba(255,255,255,.65);
    border: 1px solid #f0dfe0;
    padding: clamp(30px, 7vw, 70px);
    border-radius: 5px;
    box-shadow: 0 20px 70px rgba(113,72,78,.06);
    position: relative;
}

.letter::before {
    content: "♡";
    position: absolute;
    top: -23px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--cream);
    color: var(--rose);
    padding: 8px 15px;
    font-size: 25px;
}

.small-heading {
    text-align: center;
    color: var(--rose);
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 25px;
}

.letter h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(37px, 6vw, 55px);
    font-weight: 400;
    text-align: center;
    margin-bottom: 35px;
}

.letter p {
    font-size: 14px;
    color: #806b6e;
    line-height: 2.2;
    margin-bottom: 20px;
}

.signature {
    margin-top: 35px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
    font-style: italic;
    color: var(--rose);
    text-align: right;
}

/* COMFORT CARDS */

.comfort-heading {
    text-align: center;
    margin-bottom: 50px;
}

.comfort-heading h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 7vw, 65px);
    font-weight: 400;
}

.comfort-heading p {
    color: var(--muted);
    margin-top: 12px;
    font-size: 13px;
}

.cards {
    max-width: 1050px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: rgba(255,255,255,.65);
    border: 1px solid #f0e0e0;
    padding: 40px 25px;
    text-align: center;
    transition: .4s;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(100,50,60,.07);
}

.card .icon {
    font-size: 29px;
    margin-bottom: 20px;
}

.card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 27px;
    font-weight: 500;
    margin-bottom: 12px;
}

.card p {
    font-size: 12px;
    color: var(--muted);
    line-height: 2;
}

/* REMINDER SECTION */

.reminder {
    max-width: 750px;
    margin: 80px auto;
    padding: 65px 25px;
    text-align: center;
    background: #f7e8e8;
    position: relative;
    overflow: hidden;
}

.reminder .symbol {
    font-size: 35px;
    margin-bottom: 20px;
}

.reminder h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(38px, 7vw, 60px);
    font-weight: 400;
}

.reminder p {
    max-width: 480px;
    margin: 20px auto 0;
    color: #8e6e72;
    font-size: 13px;
    line-height: 2.1;
}

/* SURPRISE */

.surprise {
    text-align: center;
    padding: 70px 20px 100px;
}

.surprise h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 48px;
    font-weight: 400;
}

.surprise p {
    font-size: 13px;
    color: var(--muted);
    margin: 15px 0 30px;
}

.surprise button {
    background: var(--rose);
    border: none;
    padding: 16px 35px;
    color: white;
    border-radius: 40px;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: 1px;
    transition: .3s;
}

.surprise button:hover {
    background: #9e626b;
    transform: scale(1.04);
}

.hidden-message {
    display: none;
    max-width: 500px;
    margin: 35px auto 0;
    padding: 30px;
    background: white;
    border: 1px solid #efd9dc;
    animation: fadeUp .8s ease;
}

.hidden-message.show {
    display: block;
}

.hidden-message p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    color: var(--rose);
    line-height: 1.7;
}

/* FOOTER */

footer {
    text-align: center;
    padding: 35px 15px;
    border-top: 1px solid #f0e0e0;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 1px;
}

footer span {
    color: var(--rose);
}

/* MOBILE */

@media(max-width: 700px) {
    nav {
        padding: 22px 6%;
    }

    .nav-note {
        font-size: 8px;
        letter-spacing: 2px;
    }

    .hero {
        min-height: 80vh;
    }

    .cards {
        grid-template-columns: 1fr;
        max-width: 400px;
    }

    .card {
        padding: 35px 25px;
    }

    .section {
        padding: 60px 18px;
    }

    .reminder {
        margin: 50px 15px;
        padding: 55px 20px;
    }
}

</style>
</head>

<body>

<div class="background">
    <div class="glow one"></div>
    <div class="glow two"></div>
</div>

<nav>
    <div class="logo">for my girl ♡</div>
    <div class="nav-note">A little reminder of love</div>
</nav>

<!-- HERO -->

<section class="hero">

    <div class="eyebrow">A little something for you</div>

    <h1>
        Hey, <em>beautiful.</em><br>
        Take a breath.
    </h1>

    <p class="hero-text">
        I know today might not be the easiest,
        so I made you a little corner of the internet
        where you can feel loved, appreciated
        and reminded of how special you are.
    </p>

    <button class="hero-btn"
    onclick="document.getElementById('letter').scrollIntoView({behavior:'smooth'})">
        A little message for you ↓
    </button>

</section>

<div class="divider">♡</div>

<!-- LOVE LETTER -->

<section class="section" id="letter">

    <div class="letter">

        <div class="small-heading">From my heart to yours</div>

        <h2>My sweetest girl,</h2>

        <p>
            I wish I could take away every bit of discomfort
            you're experiencing right now. I know periods
            can be exhausting, uncomfortable and sometimes
            just make everything feel a little harder.
        </p>

        <p>
            But baby, I want you to remember something.
            You don't always have to be strong, cheerful
            or energetic. You don't have to pretend you're
            okay when you're not.
        </p>

        <p>
            If you need rest, please rest. If you need
            attention, you deserve it. If you feel like
            doing absolutely nothing today, that's okay too.
            Give yourself the same kindness you give
            everyone else.
        </p>

        <p>
            I love you on your energetic days, your quiet
            days, your emotional days and even the days
            when you don't feel like talking to anybody.
            Nothing about a difficult day changes how
            special you are to me.
        </p>

        <p>
            I may not be able to make every ache disappear,
            but I hope I can make your days a little softer.
            I'm here to listen, make you smile, spoil you
            with attention and remind you that you're never
            alone in this.
        </p>

        <p>
            So please take it easy, drink some water,
            get comfortable and let yourself rest.
            You deserve gentleness, patience and so much love.
        </p>

        <div class="signature">
            Always yours ♡
        </div>

    </div>

</section>

<!-- COMFORT SECTION -->

<section class="section">

    <div class="comfort-heading">
        <div class="small-heading">A few little reminders</div>
        <h2>Things I want you to know.</h2>
        <p>Read these whenever you need a little reassurance.</p>
    </div>

    <div class="cards">

        <div class="card">
            <div class="icon">🌷</div>
            <h3>You're beautiful</h3>
            <p>
                Even when you don't feel your best,
                even when you're tired, even without
                trying. You're beautiful to me.
            </p>
        </div>

        <div class="card">
            <div class="icon">🤍</div>
            <h3>You're not alone</h3>
            <p>
                You have someone who cares about you,
                wants to hear you and wants to make
                things a little easier.
            </p>
        </div>

        <div class="card">
            <div class="icon">🦋</div>
            <h3>Take your time</h3>
            <p>
                You don't owe anybody your energy today.
                Rest, relax and take things one moment
                at a time.
            </p>
        </div>

    </div>

</section>

<!-- REMINDER -->

<section class="reminder">

    <div class="symbol">♡</div>

    <h2>You deserve to be loved gently.</h2>

    <p>
        Not only when you're happy.
        Not only when you're smiling.
        Not only when everything is going perfectly.

        You deserve love, patience and understanding
        on the difficult days too.
    </p>

</section>

<!-- SURPRISE -->

<section class="surprise">

    <div class="small-heading">One last thing...</div>

    <h2>I saved something for you.</h2>

    <p>Because one message could never be enough.</p>

    <button onclick="revealMessage()">
        Open your little surprise ♡
    </button>

    <div class="hidden-message" id="secret">

        <p>
            If I could choose one place to be right now,
            it would be right beside you.

            Holding you close, playing with your hair,
            making you laugh and reminding you that
            my favourite girl deserves the whole world.

            I love you, beautiful. 🤍
        </p>

    </div>

</section>

<footer>
    Made with love, just for you <span>♥</span><br><br>
    In case you forget, you're someone's favourite person.
</footer>

<script>

// Floating hearts

function createHeart() {
    const heart = document.createElement('div');

    heart.className = 'heart';
    heart.innerHTML = Math.random() > 0.5 ? '♡' : '♥';

    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.fontSize = (12 + Math.random() * 20) + 'px';
    heart.style.animationDuration = (6 + Math.random() * 5) + 's';

    document.body.appendChild(heart);

    setTimeout(() => heart.remove(), 11000);
}

setInterval(createHeart, 900);

// Surprise message

function revealMessage() {
    const message = document.getElementById('secret');

    message.classList.toggle('show');

    if (message.classList.contains('show')) {
        message.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
        });
    }
}

</script>

</body>
</html>
